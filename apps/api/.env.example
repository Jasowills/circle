# Copy to .env and fill in
DATABASE_URL="postgresql://circle:circle@localhost:5432/circle"

JWT_ACCESS_SECRET="dev-access-secret-change-me-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# Google OAuth 2.0 — one GCP project, three OAuth clients (see README "Google setup").
# Web client (has a secret; drives the browser flow). Mobile clients are listed
# too so the backend accepts their ID tokens (audience check).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_IOS_CLIENT_ID=""
GOOGLE_ANDROID_CLIENT_ID=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
WEB_APP_URL="http://localhost:5173"

# Dev-only login bypass (email-based, no Google round-trip). NEVER enable in production.
ALLOW_DEV_LOGIN="true"

PORT="3000"
