# Copy to .env and fill in
DATABASE_URL="postgresql://circle:circle@localhost:5432/circle"

JWT_ACCESS_SECRET="dev-access-secret-change-me-min-32-chars-long"
JWT_REFRESH_SECRET="dev-refresh-secret-change-me-min-32-chars-long"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# Google OAuth 2.0 — create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:3000/auth/google/callback"
WEB_APP_URL="http://localhost:5173"

# Dev-only login bypass (email-based, no Google round-trip). NEVER enable in production.
ALLOW_DEV_LOGIN="true"

PORT="3000"
