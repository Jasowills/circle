generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CircleStatus {
  forming
  active
  goal_reached
  completed
  closed
}

enum MembershipRole {
  creator
  member
}

enum MembershipStatus {
  invited
  accepted
  active
}

enum LedgerType {
  contribution
  adjustment
}

model User {
  id           String   @id @default(uuid())
  googleId     String   @unique
  email        String   @unique
  name         String
  avatarUrl    String?
  passwordHash String?
  createdAt    DateTime @default(now())

  memberships CircleMembership[]
  ledgerEntries LedgerEntry[]
  refreshTokens RefreshToken[]
  createdCircles Circle[] @relation("CreatedCircles")
  cyclesReceived CircleCycle[] @relation("CycleRecipients")
  wallet Wallet?
}

model Circle {
  id          String       @id @default(uuid())
  name        String
  goalAmount  Decimal      @db.Decimal(18, 2)
  currency    String       @default("NGN")
  status      CircleStatus @default(forming)
  createdById String
  createdBy   User         @relation("CreatedCircles", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  // Rotation (v2 Ajo mechanics). Null = legacy goal-only circle.
  contributionAmount Decimal? @db.Decimal(18, 2)
  targetMembers      Int?
  cycleLengthDays    Int      @default(7)
  // How many times per week a member may contribute. Null = whenever.
  contributionsPerWeek Int?
  rotationMode       String   @default("random_draw")
  rotationOrder      String[] @default([])

  memberships CircleMembership[]
  ledgerEntries LedgerEntry[]
  cycles CircleCycle[]
}

enum CycleStatus {
  pending
  collecting
  payout_completed
}

model CircleCycle {
  id            String      @id @default(uuid())
  circleId      String
  circle        Circle      @relation(fields: [circleId], references: [id], onDelete: Cascade)
  cycleNumber   Int
  recipientId   String
  recipient     User        @relation("CycleRecipients", fields: [recipientId], references: [id])
  startsAt      DateTime
  endsAt        DateTime
  targetPot     Decimal     @db.Decimal(18, 2)
  status        CycleStatus @default(pending)

  @@unique([circleId, cycleNumber])
  @@index([circleId])
}

enum WalletTxType {
  demo_fund
  fund
  circle_contribution
  circle_payout
}

model Wallet {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  transactions WalletTransaction[]
}

model WalletTransaction {
  id             String       @id @default(uuid())
  walletId       String
  wallet         Wallet       @relation(fields: [walletId], references: [id], onDelete: Cascade)
  amount         Decimal      @db.Decimal(18, 2)
  type           WalletTxType
  relatedCircleId String?
  relatedCycleId  String?
  idempotencyKey String
  createdAt      DateTime     @default(now())

  // Same append-only + idempotency discipline as the circle ledger.
  @@unique([walletId, idempotencyKey])
  @@index([walletId])
}

model CircleMembership {
  id       String           @id @default(uuid())
  circleId String
  circle   Circle           @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     MembershipRole   @default(member)
  status   MembershipStatus @default(invited)
  invitedAt DateTime        @default(now())
  joinedAt  DateTime?
  // When true, the background job contributes the fixed step on schedule.
  autoContribute Boolean @default(false)

  @@unique([circleId, userId])
  @@index([userId])
}

model LedgerEntry {
  id             String     @id @default(uuid())
  circleId       String
  circle         Circle     @relation(fields: [circleId], references: [id], onDelete: Cascade)
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount         Decimal    @db.Decimal(18, 2)
  type           LedgerType @default(contribution)
  idempotencyKey String
  cycleId        String?
  createdAt      DateTime   @default(now())

  // Idempotency: a retried request with the same key returns the original row.
  @@unique([circleId, userId, idempotencyKey])
  @@index([circleId])
  @@index([circleId, userId])
}

// NOTE: LedgerEntry has NO update/delete path anywhere in the codebase.
// Corrections are new `adjustment` rows, never edits. This is append-only by convention
// (enforced in code review + the absence of any prisma.ledgerEntry.update/delete call).

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
}
