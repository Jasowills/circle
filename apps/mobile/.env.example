# Emulator talks to the host machine differently per platform:
# Android emulator -> host is 10.0.2.2 ; iOS simulator -> use http://localhost:3000.
EXPO_PUBLIC_API_URL="http://10.0.2.2:3000"

# Google OAuth client IDs (Google Cloud Console → APIs & Services → Credentials).
# Web client ID is required for expo-auth-session; add platform IDs as needed.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=""
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=""
